# Copia este archivo como .env  →  cp .env.example .env
# Aquí va SOLO configuración NO sensible. Las contraseñas viven en ./secrets/

# PostgreSQL
POSTGRES_DB=sistema_documental
POSTGRES_USER=docs_admin
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Almacenamiento S3-compatible
STORAGE_IMAGE=pgsty/minio:latest
STORAGE_API_PORT=9000
STORAGE_CONSOLE_PORT=9001
STORAGE_BUCKET=documentos

# Portainer (perfil "admin")
PORTAINER_IMAGE=portainer/portainer-ce:lts
PORTAINER_PORT=9443

# helmet
FRONTEND_ORIGIN=http://localhost:5173

# false solo en desarrollo (http); en producción quitar o poner true
COOKIE_SEGURA=false

# API en Docker (perfil "app")
API_PORT=3001
# Solo para probar en local; en produccion: quitar o poner false
SWAGGER_HABILITADO=true
