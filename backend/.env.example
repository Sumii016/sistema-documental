# Copia este archivo como .env  →  copy .env.example .env
# Aquí NO van contraseñas: *_FILE dice DÓNDE está el secreto, no CUÁL es.

HOST=127.0.0.1
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sistema_documental
DB_USER=docs_app
DB_PASSWORD_FILE=../secrets/postgres_app_password.txt

#Redis

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD_FILE=../secrets/redis_password.txt

#Almacenamiento S3 (Usuario limitado docs_app, NO el root)
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=documentos
STORAGE_ACCESS_KEY_FILE=../secrets/storage_app_access_key.txt
STORAGE_SECRET_KEY_FILE=../secrets/storage_app_secret_key.txt

# Solo para migraciones (la API NO usa estas variables)
DB_ADMIN_USER=docs_admin
DB_ADMIN_PASSWORD_FILE=../secrets/postgres_password.txt

#helmet
FRONTEND_ORIGIN=http://localhost:5173

#swagger true solo en desarrollo; en producción false o sin definir
SWAGGER_HABILITADO=true

#Redis
SESSION_SECRET_FILE=../secrets/session_secret.txt
COOKIE_SEGURA=false
# Pruebas E2E
E2E_URL=http://127.0.0.1:3000
E2E_ADMIN_CORREO=e2e-admin@prueba.local
E2E_ADMIN_CONTRASENA_FILE=../secrets/e2e_admin_password.txt
